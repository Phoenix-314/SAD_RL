[settings]
os=Emscripten
arch=wasm
compiler=emcc
compiler.version=3.1.73
compiler.cppstd=20
build_type=Release

[options]
boost/*:without_stacktrace=True
libwebp/*:with_simd=False
libtiff/*:lzma=False

[replace_requires]
freetype/2.13.2: freetype/2.12.1

[tool_requires]
emsdk/3.1.73
make/4.4.1
ninja/1.13.2

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.gnu:make_program=!
tools.build:cflags=["-pthread"]
tools.build:cxxflags=["-pthread"]
tools.build:sharedlinkflags=["-pthread"]
tools.build:exelinkflags=["-pthread"]
